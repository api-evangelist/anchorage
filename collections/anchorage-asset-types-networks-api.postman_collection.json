                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/asset-types?networkId=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "asset-types"
              ],
              "query": [
                {
                  "description": "Filter by specific network ID. Returns only assets on the specified network.",
